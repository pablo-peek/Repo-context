{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "allowJs": true,
    "sourceMap": true,  
    "outDir": "dist",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "alwaysStrict": true,
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": ["src/**/*"],
  "exclude": ["./src/__tests__/**", "./src/**/*.spec.ts", "./src/**/*.mock.ts", "node_modules"]
}
